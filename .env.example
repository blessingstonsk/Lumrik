# ─────────────────────────────────────────────────────────────
# Lumrik environment variables
# Copy to .env.local and fill in. Without Supabase variables the
# app runs in LOCAL MODE (accounts + progress stored in this browser).
# ─────────────────────────────────────────────────────────────

# Public site URL (used for auth redirects, e.g. Google OAuth / password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes to award XP / write progress after validating answers.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI tutor + writing feedback (server-only). Set ONE of these. ──
# Option A – Google Gemini, FREE tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Option B – Anthropic Claude (paid, highest quality)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# If both keys are set, Claude is used. Set AI_PROVIDER=gemini to force Gemini.
AI_PROVIDER=
